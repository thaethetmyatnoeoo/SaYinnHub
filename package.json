    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "lucide-react": "1.69.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "vite": "8.3.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
